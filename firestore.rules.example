rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email == 'REPLACE_WITH_YOUR_ADMIN_EMAIL';
    }
    match /puzzles/{id} {
      allow read: if resource.data.status == 'approved' || admin();
      allow write: if admin();
    }
    match /games/{id} {
      allow read: if true;
      allow create: if admin() || (request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.date is string
        && id == request.auth.uid + '_' + request.resource.data.date);
      allow update, delete: if admin();
    }
  }
}
